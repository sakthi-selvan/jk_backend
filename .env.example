# App Config
APP_NAME=JK Taxi API
DEBUG=True
API_VERSION=v1

# Database
DATABASE_URL=postgresql://jktaxi:jktaxi123@localhost:5432/jktaxi_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (keep short-lived in production)
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP — set ALLOW_STATIC_OTP=true ONLY for local/dev
ALLOW_STATIC_OTP=true
STATIC_OTP=1234
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_COUNT=5
OTP_RATE_LIMIT_WINDOW_SECONDS=600

# TeleSign (required when ALLOW_STATIC_OTP=false)
TELESIGN_CUSTOMER_ID=
TELESIGN_API_KEY=

# Razorpay (required for online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Ops
ALLOW_FORCE_COMPLETE=false

# Mapbox server routing + mobile maps (use a pk. public token)
MAPBOX_ACCESS_TOKEN=
# Optional; if empty, MAPBOX_ACCESS_TOKEN is used for apps when it starts with pk.
MAPBOX_PUBLIC_TOKEN=
MAPBOX_ROUTING_PROFILE=driving-traffic
MIN_FARE_DISTANCE_KM=1.0
FALLBACK_SPEED_KMH=30

# Service area (Tamil Nadu-ish). Set SERVICE_AREA_ENABLED=false to disable.
SERVICE_AREA_ENABLED=true
SERVICE_AREA_BBOX=76.0,8.0,80.5,13.6

# Dispatch — sequential one-by-one exclusive offers
SEQUENTIAL_DISPATCH=true
OFFER_TTL_SECONDS=300
DRIVER_OFFER_SECONDS=25
STALE_GPS_SECONDS=120
ENFORCE_VEHICLE_MATCH=true
REQUIRE_DRIVER_DOCS=false
REQUIRE_AADHAR_DOCUMENT=false
REQUIRE_DRIVER_VERIFIED=true
SCHEDULED_RELEASE_MINUTES=30
SCHEDULED_LATE_GRACE_MINUTES=15
DISPATCH_SWEEP_SECONDS=10
MAX_PICKUP_ETA_MINUTES=30

SURGE_PEAK_MULTIPLIER=1.2
CANCEL_FEE_ACCEPTED=30
CANCEL_FEE_STARTED=50

# CORS (admin/portfolio Vite + Expo)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://localhost:8081","http://localhost:19000","http://localhost:19006","https://jktaxitamilnadu.com","https://admin.jktaxitamilnadu.com"]
